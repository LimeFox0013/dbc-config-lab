{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:e2e"
  ],
  "implicitDependencies": [
    "web"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "apps/web-e2e"
      }
    },
    "e2e:ui": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "playwright test --ui",
        "cwd": "apps/web-e2e"
      }
    }
  }
}
